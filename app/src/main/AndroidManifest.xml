        <package android:name="com.simplemobiletools.filemanager.pro"/>
        <package android:name="com.sonymobile.FileExplorer"/>
        <package android:name="com.speedsoftware.rootexplorer"/>
        <package android:name="com.transsion.filemanager"/>
        <package android:name="com.vivo.filemanager"/>
        <package android:name="dev.dworks.apps.anexplorer"/>
