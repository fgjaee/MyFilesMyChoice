<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Permissions (optional, kept as you had) ===== -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- ===== Visibility queries (Android 11+) ===== -->
    <queries>
        <!-- Core system + SAF -->
        <intent><action android:name="android.intent.action.GET_CONTENT" /></intent>
        <intent><action android:name="android.intent.action.OPEN_DOCUMENT" /></intent>
        <intent><action android:name="android.intent.action.OPEN_DOCUMENT_TREE" /></intent>
        <intent><action android:name="android.intent.action.CREATE_DOCUMENT" /></intent>
        <intent><action android:name="android.intent.action.PICK" /></intent>

        <!-- Popular mainstream file managers -->
        <package android:name="com.cxinventor.file.explorer" />
        <package android:name="pl.solidexplorer2" />
        <package android:name="com.lonelycatgames.Xplore" />
        <package android:name="com.amaze.filemanager" />
        <package android:name="com.alphainventor.filemanager" />
        <package android:name="tools.filemanager" />
        <package android:name="com.metago.astro" />
        <package android:name="pl.mkexplorer" />
        <package android:name="com.mobisystems.fileman" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.xfolder.filemanager" />

        <!-- Root-capable & advanced -->
        <package android:name="com.speedsoftware.rootexplorer" />
        <package android:name="com.ghisler.android.TotalCommander" />
        <package android:name="com.ghisler.android.TotalCommander.plugins" />
        <package android:name="com.mixplorer.silver" />
        <package android:name="com.mixplorer" />
        <package android:name="bin.mt.plus" />
        <package android:name="com.rs.explorer.filemanager" />
        <package android:name="com.ghostsq.commander" />
        <package android:name="nextapp.fx" />
        <package android:name="nextapp.fx.rk" />
        <package android:name="nextapp.fx.plus" />

        <!-- Archive/file tools often used as managers -->
        <package android:name="ru.zdevs.zarchiver" />
        <package android:name="com.rarlab.rar" />

        <!-- OEM / System file managers -->
        <package android:name="com.mi.android.globalFileexplorer" />
        <package android:name="com.android.fileexplorer" />
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.asus.filemanager" />
        <package android:name="com.huawei.hidisk" />

        <!-- Legacy but still used -->
        <package android:name="com.estrongs.android.pop" />
        <package android:name="org.openintents.filemanager" />
    </queries>

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FileManagerRedirect">

        <!-- ===== LSPosed / Xposed module metadata (REQUIRED) ===== -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Redirects Android file picker intents to your chosen file manager." />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <!-- Launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/title_activity_settings"
            android:exported="false" />

        <!-- Redirect shim that forwards to the chosen file manager -->
        <activity
            android:name=".RedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FileManagerRedirect.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.OPEN_DOCUMENT" />
                <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
                <action android:name="android.intent.action.CREATE_DOCUMENT" />
                <action android:name="android.intent.action.GET_CONTENT" />
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>
</manifest>