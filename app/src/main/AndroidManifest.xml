        <package android:name="com.google.android.marvin.talkback"/>
        <package android:name="com.htc.filemanager"/>
        <package android:name="com.huawei.hidisk"/>
        <package android:name="com.lenovo.FileBrowser"/>
        <package android:name="com.lge.filemanager"/>
        <package android:name="com.lonelycatgames.Xplore"/>
        <package android:name="com.marc.files"/>
        <package android:name="com.mdroiddev.filemanager"/>
        <package android:name="com.mi.android.globalFileexplorer"/>
