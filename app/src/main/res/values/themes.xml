<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- App theme -->
    <style name="Theme.FileManagerRedirect" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Keep simple overrides so older widgets still colorize -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>

        <!-- Optional surface/background hints for Material2-era attrs some libs still read -->
        <item name="android:colorBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/teal_200</item>

        <!-- Avoid data binding preview noise -->
        <item name="tools:targetApi">31</item>
    </style>
</resources>