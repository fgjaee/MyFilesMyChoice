<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Mirror the same choices as full-backup-content -->
        <include domain="sharedpref" path="."/>
        <include domain="files" path="."/>
        <exclude domain="cache" path="."/>
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="files" path="."/>
        <exclude domain="cache" path="."/>
    </device-transfer>
</data-extraction-rules>